#!/usr/bin/env bash
#
# darkaifactory pre-commit hook.
#
# Runs format check, lint, tests, and a coverage regression check before
# allowing a commit. Install with `make hooks`.
#
# Skip with `git commit --no-verify` (discouraged — only when you know why).

set -euo pipefail

# Run from the repo root regardless of where git invokes the hook from.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] gofumpt check..."
make --no-print-directory check-fmt

echo "[pre-commit] golangci-lint..."
make --no-print-directory lint

# cover-check runs the full test suite under -coverprofile, so we don't
# also need a separate `make test` — that would double-run every test.
echo "[pre-commit] go test + coverage regression check (limit: 1.00pp drop)..."
make --no-print-directory cover-check

echo "[pre-commit] benchmark regression check (fail >2.00x, warn >1.10x)..."
make --no-print-directory bench-check

# Integration tests need /dev/kvm, the Nix toolchain, and the
# artefacts they build. Linux+KVM is a hard prerequisite for this
# project — there is no useful work in this codebase that doesn't
# need it, so any developer who can write sandbox code already has
# the prerequisites. CI environments without KVM are useless here
# and have no business gating commits.
#
# Use --no-verify only for genuine doc-only commits where you can
# defend the choice in code review.
echo "[pre-commit] KVM-gated integration tests..."
make --no-print-directory integration

echo "[pre-commit] OK"
