#!/usr/bin/env bash
#
# darkaifactory pre-commit hook.
#
# Runs format check, lint, tests, and a coverage regression check before
# allowing a commit. Install with `make hooks`.
#
# Skip with `git commit --no-verify` (discouraged — only when you know why).

set -euo pipefail

# Run from the repo root regardless of where git invokes the hook from.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-commit] gofumpt check..."
make --no-print-directory check-fmt

echo "[pre-commit] golangci-lint..."
make --no-print-directory lint

# cover-check runs the full test suite under -coverprofile, so we don't
# also need a separate `make test` — that would double-run every test.
echo "[pre-commit] go test + coverage regression check (limit: 1.00pp drop)..."
make --no-print-directory cover-check

echo "[pre-commit] benchmark regression check (fail >2.00x, warn >1.10x)..."
make --no-print-directory bench-check

# Integration tests need /dev/kvm, the Nix toolchain, and the artefacts
# they build. A dev workstation that can run the sandbox at all has all
# three. CI environments without /dev/kvm should run pre-commit on a
# machine that does — same logic as "you can't develop the sandbox
# without /dev/kvm". Skip with --no-verify only when intentionally
# committing on a non-sandbox host (e.g. doc-only changes from a Mac).
echo "[pre-commit] KVM-gated integration tests..."
if [ ! -e /dev/kvm ]; then
	echo "  /dev/kvm missing — skipping integration tests."
	echo "  (This is the only legitimate skip; if you're on a sandbox"
	echo "  host, fix KVM access before committing sandbox changes.)"
elif ! command -v nix >/dev/null 2>&1; then
	echo "  nix missing — skipping integration tests. Install nix or"
	echo "  commit from a host with the dev shell available."
else
	make --no-print-directory integration
fi

echo "[pre-commit] OK"
