#!/usr/bin/env bash
#
# vmjail pre-commit hook.
#
# Delegates to `make verify`, which is the single source of truth for
# what gates a commit: fmt + lint + unit tests + coverage + e2e (real
# VM boot against /dev/kvm) + benchmark regression + a 1s/target fuzz
# sweep. Each of those is its own Makefile target, so anyone who wants
# to debug a specific failure can run that target on its own.
#
# Do NOT bypass this with `git commit --no-verify`. The gates exist
# because previous slips made it through review; bypassing them
# re-creates the failure modes they were added to prevent. If a gate
# is wrong for your change, fix the gate (and document why) — don't
# ship around it.

set -euo pipefail

# Run from the repo root regardless of where git invokes the hook from.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# `make integration` needs the dev shell's tools (u-root, gzip, cpio)
# plus the pinned VMJAIL_* artefact env vars. direnv-aware shells
# already have these via flake.nix; for shells where git is invoked
# outside the dev shell, fall back to `nix develop -c` so the hook
# still works.
if [ -n "${VMJAIL_UROOT:-}" ]; then
	make --no-print-directory verify
else
	nix develop -c make --no-print-directory verify
fi

echo "[pre-commit] OK"
