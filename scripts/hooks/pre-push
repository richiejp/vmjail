#!/usr/bin/env bash
#
# vmjail pre-push hook.
#
# Runs `nix flake check`, which builds every flake package output (the
# Go binaries, kernel, cloud-hypervisor, virtiofsd, crun, u-root,
# initramfs, hello-bundle, the //go:embed-bundled vmjail-sandboxd, and
# the test-fixture images) and evaluates the flake's checks.
#
# This is the RELEASE build path, and it is deliberately NOT in the
# pre-commit gate. `make verify` (pre-commit) builds our Go binaries
# with `go build` and assembles the initramfs/bundle via Make recipes
# that run *parallel* to the corresponding Nix derivations — so a
# break in `nix build .#vmjail` / `.#initramfs` / etc. stays invisible
# to a commit. Gating it on push catches that before it reaches CI
# (.github/workflows/validate-build.yml runs the same check).
#
# Cost: slow on a cold /nix/store (it compiles the kernel + the Rust
# components from source); near-instant when those are cache hits, so
# the steady-state push cost is just our Go derivations.
#
# Do NOT bypass with `git push --no-verify`. If the flake build is
# wrong for your change, fix the flake (and say why) — don't ship a
# release build that doesn't build.

set -euo pipefail

# Run from the repo root regardless of where git invokes the hook from.
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] nix flake check (full release build)..."
nix flake check -L

echo "[pre-push] OK"
