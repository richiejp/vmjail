digraph orchestrator_lifecycle {
  graph [fontname="sans-serif", rankdir=LR];
  node [fontname="sans-serif", shape=box, style="rounded"];
  edge [fontname="sans-serif", fontsize=10];
  stopped [label="Stopped"];
  configured [label="Configured"];
  recovering [label="Recovering stores"];
  controllers [label="Starting controllers"];
  serving [label="Serving"];
  draining [label="Draining"];
  failed [label="Failed\nno admission", color="#b45309"];
  stopped -> configured [label="Configure"];
  configured -> recovering [label="OpenStores"];
  recovering -> controllers [label="recovery complete"];
  controllers -> serving [label="Listen"];
  serving -> draining [label="Drain"];
  draining -> stopped [label="Close"];
  configured -> failed [label="invalid"];
  recovering -> failed [label="repair failure"];
  controllers -> failed [label="required controller failure"];
  serving -> failed [label="required runtime failure"];
  failed -> stopped [label="close partial state"];
}
