digraph node_lifecycle {
  graph [fontname="sans-serif", rankdir=LR];
  node [fontname="sans-serif", shape=box, style="rounded"];
  edge [fontname="sans-serif", fontsize=10];
  unknown [label="Unknown"];
  connected [label="Connected\nnot authorised"];
  authorised [label="Authorised"];
  reconciling [label="Reconciling inventory"];
  active [label="Active"];
  suspect [label="Suspect\nno new work", color="#b45309"];
  disconnected [label="Disconnected"];
  draining [label="Draining"];
  revoked [label="Revoked\nno registration", color="#b45309"];
  removed [label="Removed"];
  unknown -> connected [label="Connect"];
  connected -> authorised [label="Authorise"];
  authorised -> reconciling [label="Register"];
  reconciling -> active [label="inventory accepted"];
  active -> suspect [label="MissHeartbeat", color="#b45309"];
  suspect -> active [label="fresh heartbeat"];
  suspect -> disconnected [label="grace expires"];
  active -> disconnected [label="stream closes"];
  disconnected -> reconciling [label="Reconnect"];
  active -> draining [label="Drain"];
  draining -> disconnected [label="work terminal"];
  authorised -> revoked [label="Revoke", color="#b45309"];
  reconciling -> revoked [label="Revoke", color="#b45309"];
  active -> revoked [label="Revoke", color="#b45309"];
  suspect -> revoked [label="Revoke", color="#b45309"];
  draining -> revoked [label="Revoke", color="#b45309"];
  revoked -> connected [label="Reconnect"];
  disconnected -> removed [label="fence + resolve storage"];
}
