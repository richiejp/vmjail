digraph sandbox_lifecycle {
  graph [fontname="sans-serif", rankdir=LR];
  node [fontname="sans-serif", shape=box, style="rounded"];
  edge [fontname="sans-serif", fontsize=10];
  prepare [label="Prepare host, bundle\nand direct shares"];
  start [label="Start virtiofsd,\nlisteners and VMM"];
  guest [label="Configure guest mounts\nand instrumentation"];
  workload [label="Run container"];
  cleanup [label="Close listeners\nand reap children"];
  stopped [label="Remove cgroup\nRetain diagnostics"];
  prepare -> start;
  start -> guest;
  guest -> workload;
  workload -> cleanup [label="completion / cancellation"];
  prepare -> cleanup [label="failure"];
  start -> cleanup [label="failure"];
  guest -> cleanup [label="failure"];
  cleanup -> stopped;
}
