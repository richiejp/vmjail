digraph sandbox_lifecycle {
  graph [fontname="sans-serif", rankdir=LR];
  node [fontname="sans-serif", shape=box, style="rounded"];
  edge [fontname="sans-serif", fontsize=10];
  absent [label="Absent"];
  dispatched [label="Dispatched"];
  preparing [label="Preparing host"];
  booting [label="Booting VM"];
  attaching [label="Attaching guest"];
  running [label="Running"];
  stopping [label="Stopping"];
  preserving [label="Preserving"];
  failing [label="Failing\nbounded reason", color="#b45309"];
  terminal [label="Terminal"];
  unknown [label="Unknown", color="#b45309"];
  absent -> dispatched [label="Dispatch"];
  dispatched -> preparing [label="Prepare"];
  preparing -> booting [label="preconditions pass"];
  booting -> attaching [label="guest live"];
  attaching -> running [label="StartWorkload"];
  running -> stopping [label="Stop"];
  stopping -> preserving [label="routes closed"];
  preserving -> terminal [label="PublishTerminal"];
  dispatched -> failing [label="dispatch failure", color="#b45309"];
  preparing -> failing [label="precondition failure", color="#b45309"];
  booting -> failing [label="boot failure", color="#b45309"];
  attaching -> failing [label="attach failure", color="#b45309"];
  running -> failing [label="workload failure", color="#b45309"];
  failing -> preserving [label="teardown + preserve"];
  dispatched -> unknown [label="Node loss", color="#b45309"];
  preparing -> unknown [label="Node loss", color="#b45309"];
  booting -> unknown [label="Node loss", color="#b45309"];
  attaching -> unknown [label="Node loss", color="#b45309"];
  running -> unknown [label="Node loss", color="#b45309"];
  stopping -> unknown [label="Node loss", color="#b45309"];
  preserving -> unknown [label="Node loss", color="#b45309"];
}
