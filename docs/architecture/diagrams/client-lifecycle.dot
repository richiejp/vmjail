digraph client_lifecycle {
  graph [fontname="sans-serif", rankdir=TB];
  node [fontname="sans-serif", shape=box, style="rounded"];
  edge [fontname="sans-serif", fontsize=10];
  subgraph cluster_identity {
    label="Identity and trust";
    unconfigured [label="Unconfigured"];
    local [label="Local identity"];
    pinned [label="Peer pinned"];
    authorised [label="Authorised"];
    revoked [label="Revoked"];
    unconfigured -> local [label="Initialise"];
    local -> pinned [label="PinPeer"];
    pinned -> authorised [label="Authorise"];
    authorised -> revoked [label="Revoke"];
  }
  subgraph cluster_operation {
    label="One bounded operation";
    prepared [label="Prepared"];
    sent [label="Sent"];
    acknowledged [label="Acknowledged"];
    outcome_unknown [label="OutcomeUnknown", color="#b45309"];
    rejected [label="Rejected"];
    prepared -> sent [label="send with preconditions"];
    sent -> acknowledged [label="exact postcondition"];
    sent -> outcome_unknown [label="timeout / transport loss", color="#b45309"];
    sent -> rejected [label="definitive response"];
    outcome_unknown -> prepared [label="reconcile then safe retry"];
  }
  authorised -> prepared [label="begin operation"];
  revoked -> local [label="reconfigure trust"];
}
