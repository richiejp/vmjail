# vmjail-specific *feature* fragment for the sandbox-VM kernel.
#
# The kernel is built from the ground up (not defconfig): `make tinyconfig`
# then merge_config.sh folds, in order, kvm_guest.config (upstream KVM-guest
# essentials) + microvm-base.config (re-add what tinyconfig drops + trim
# bloat) + this file (vmjail features) + microvm-hardening.config (KSPP
# hardening, merged last so it wins). See the kernel derivation in flake.nix.
#
# This file carries only vmjail's *features*: virtio over PCI for I/O, vsock
# for the controller↔agent channel, virtiofs for the workspace and OCI
# bundle, VFIO for GPU passthrough, nested-KVM host support, the container
# plumbing crun needs, and the initramfs path our u-root init takes. Kernel
# minimalism lives in microvm-base.config; hardening (incl. the clang-only
# CFI below) in microvm-hardening.config.
#
# After modifying this file, run `make olddefconfig` in the build tree to
# fold the fragment into a complete .config. Nix does this automatically.

# --- KVM guest -------------------------------------------------------------
CONFIG_HYPERVISOR_GUEST=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# --- KVM host (nested virtualisation) ------------------------------------
# Makes the vmjail VM itself a KVM hypervisor so its containers can boot
# nested VMs — required to develop and test vmjail inside a vmjail
# sandbox (e.g. `make integration`, which boots real VMs against /dev/kvm).
# Built-in (CONFIG_MODULES is off), so /dev/kvm appears via devtmpfs at
# boot. Cloud Hypervisor already exposes the VMX CPUID bit to the guest
# by default (--cpus nested toggle defaults on), and the host has
# kvm_intel.nested=Y, so the L1 VM sees `vmx` in /proc/cpuinfo. Both
# Intel and AMD vendor backends are enabled so the same image boots on
# either host. nested=1 is the modern default for kvm_intel/kvm_amd.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# --- PVH boot (Cloud Hypervisor's default boot path) ----------------------
CONFIG_PVH=y

# --- virtio over PCI ------------------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- retained workspace filesystem ---------------------------------------
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_QUOTA=y
CONFIG_QUOTA_TREE=y
CONFIG_QFMT_V2=y
CONFIG_FS_POSIX_ACL=y

# --- vsock (controller ↔ in-VM agent) ------------------------------------
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# --- virtiofs (workspace + OCI bundle share) -----------------------------
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# --- VFIO (PCI/GPU passthrough into the VM) ------------------------------
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_VFIO_IOMMU_TYPE1=y

# --- Initramfs / initrd --------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y

# --- Console -------------------------------------------------------------
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_CONSOLE=y

# --- eBPF + BPF LSM (post-v1 syscall policy) -----------------------------
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
# BPF_LSM depends on BPF_EVENTS (kernel/trace/Kconfig:853) which itself
# requires (KPROBE_EVENTS || UPROBE_EVENTS) && PERF_EVENTS. Pull in the
# minimal tracing/perf set so BPF programs can actually attach to the
# security hooks — without these, olddefconfig silently demotes BPF_LSM
# to n on the tinyconfig base. Bloat we accept because BPF LSM is the
# planned policy layer. With KPROBES=y + FTRACE=y, KPROBE_EVENTS and
# BPF_EVENTS come up `default y`; BPF_EVENTS is re-asserted in the CO-RE
# block below so the kconfig-verify gate locks it in.
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_BPF_LSM=y

# --- Tier 2 CO-RE eBPF observability gadgets -----------------------------
# Host-side Tier 1 (the /proc + cgroup + net sampler in
# internal/observability) watches the cloud-hypervisor process from the
# outside; it cannot answer guest-internal questions ("what file did the
# workload fail to open?", "where is virtio-blk latency coming from?").
# Those are answered by a curated library of CO-RE eBPF gadgets that run
# *inside* the guest (cilium/ebpf, one ELF per question — see
# OBSERVABILITY.md "Tier 2"). CO-RE needs the kernel's own BTF type
# information embedded in the image, plus the tracepoint/symbol machinery
# the gadgets attach to.
#
# DEBUG_INFO_BTF requires debug info, so flip the "Debug information"
# choice off its DEBUG_INFO_NONE default to TOOLCHAIN_DEFAULT (which
# `select`s DEBUG_INFO and lets clang pick its own DWARF version — pahole,
# already in the kernel derivation's nativeBuildInputs, turns that into
# BTF). RANDSTRUCT is off (RANDSTRUCT_NONE) so BTF's
# `!GCC_PLUGIN_RANDSTRUCT` dependency is met. KALLSYMS_ALL gives kprobes
# the full symbol table; FTRACE_SYSCALLS adds the sys_enter/sys_exit
# tracepoints the first gadget (open-snoop) attaches to.
#
# UPROBES and BPF_EVENTS are already `def_bool y` here (UPROBES from
# ARCH_SUPPORTS_UPROBES+MMU, BPF_EVENTS from KPROBES+FTRACE above); they're
# re-asserted so a future fragment change that knocks out a dependency
# fails the kconfig-verify gate loudly instead of silently dropping CO-RE
# attach support.
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_UPROBES=y
CONFIG_BPF_EVENTS=y

# --- Tier 1 per-task I/O accounting (/proc/<pid>/io) ---------------------
# The always-on Tier-1 sampler (internal/observability) reads
# /proc/<pid>/{stat,status,io}. The `io` file (rchar/wchar + read/write
# syscall + actual block-I/O byte counters) only exists with
# CONFIG_TASK_IO_ACCOUNTING, gated behind TASK_XACCT -> TASKSTATS
# (TASKSTATS needs NET + MULTIUSER, both already on). tinyconfig drops
# the whole chain, so without these readProcIO fails with "no such
# file" and the in-sandbox observability test (collectProcSample on
# self) errors. All three are set explicitly: olddefconfig won't
# auto-enable a dependency, so requesting only the leaf would have it
# demoted back to n. kconfig-verify then locks the chain in.
CONFIG_TASKSTATS=y
CONFIG_TASK_XACCT=y
CONFIG_TASK_IO_ACCOUNTING=y

# --- Userland container plumbing -----------------------------------------
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y

# --- TUN/TAP for the vmjail-agent <-> sandboxnet bridge --------------------
# The agent opens /dev/net/tun + TUNSETIFF to create tap0, then runs the
# rx/tx pump between tap0 and the AF_VSOCK conn into the host's
# gvisor-tap-vsock netstack. Without CONFIG_TUN the guest has no path to
# the host network and the D6c.2 slice-4 HTTPS-egress integration test
# fails with ENETUNREACH on every connect.
CONFIG_TUN=y

# --- KCFI / FineIBT (clang-only forward-edge control-flow integrity) -----
# The flake builds the kernel target with clang (CC=clang — see kmakeTools
# in flake.nix); gcc has no equivalent, so this is the headline reason for
# the clang switch. Indirect calls are checked against a per-prototype type
# hash, so a corrupted function pointer can't redirect to an arbitrary
# address; with X86_KERNEL_IBT this auto-enables FineIBT (KCFI + CET IBT),
# the strongest x86 forward-edge CFI. olddefconfig drops CONFIG_CFI if ever
# built with gcc. (CONFIG_CFI is the 7.0 rename of CONFIG_CFI_CLANG.) The
# rest of the KSPP hardening lives in microvm-hardening.config.
CONFIG_CFI=y

# --- Strip what we don't need (smaller kernel, faster boot) --------------
# Loadable modules are disabled in prod (PLAN.md "Hardening"); everything
# we need is built in.
# CONFIG_MODULES is not set
# CONFIG_SOUND is not set
# CONFIG_USB is not set
# CONFIG_PCMCIA is not set
# WIRELESS itself isn't user-settable — it's force-`select`ed by
# `menuconfig WLAN` (drivers/net/wireless/Kconfig:6), which is
# `default y` on any NET build, so `# CONFIG_WIRELESS is not set` was
# silently overridden. Disabling WLAN drops the select, leaving
# WIRELESS off (and the whole wireless-driver menu out of the build).
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
