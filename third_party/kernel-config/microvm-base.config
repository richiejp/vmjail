# microvm essentials: re-add the core features a defconfig has for free but
# allnoconfig/tinyconfig omit. Curated for a Cloud Hypervisor PVH guest that
# runs the Go daft-agent (futex/epoll/*fd) + crun (namespaces/cgroups/seccomp).
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
# fcntl/flock advisory locks. tinyconfig drops this (it's `if EXPERT`,
# and allnoconfig turns EXPERT-gated defaults off); without it fcntl
# locking returns ENOSYS, and Nix can't take its store lock — every
# in-VM `nix` invocation dies with "acquiring/releasing lock: Function
# not implemented". crun and overlayfs want it too.
CONFIG_FILE_LOCKING=y
# binfmt_script: the kernel handler that makes `#!`-shebang scripts
# directly executable via execve(2). tinyconfig drops it (also
# `if EXPERT`); without it execve of any script returns ENOEXEC
# ("exec format error") — `sh script.sh` still works (the interpreter
# reads the file) but `./script.sh` and Go's exec.Command(script) do
# not. crun hook scripts, dev-shell wrappers, and daft's own in-sandbox
# test suite (internal/userns execs `#!/bin/sh` stubs) all need it.
CONFIG_BINFMT_SCRIPT=y
CONFIG_MEMBARRIER=y
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_HW_RANDOM=y
CONFIG_UNIX98_PTYS=y
CONFIG_FUTEX_PI=y
# cgroup v2 controllers crun touches; device controller is eBPF-based
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_CPUSETS=y
# net stack basics for vsock/tap (kvm_guest gives NET/INET)
CONFIG_NETLINK_DIAG=y
CONFIG_UNIX=y
CONFIG_SYSVIPC=y
CONFIG_PRINTK_TIME=y
# defconfig defaults this on; allnoconfig forces it off, which makes the benign
# FineIBT (KCFI+CET-IBT) early-boot section mismatches into fatal modpost
# errors. __apply_fineibt legitimately calls .init.text patchers while .init
# still exists, so downgrade mismatches to warnings.
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
# No PS/2 in a microvm: the i8042 probe times out ~500ms (no ACPI to say
# "no keyboard"), dwarfing the rest of boot. Drop the legacy serio/AT stack;
# virtio-input covers any console input.
# CONFIG_SERIO is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_MOUSE is not set

# --- Bloat trim: subsystems kvm_guest.config pulls in that daft never uses.
# daft shares the workspace + OCI bundle over virtiofs (not 9p), runs headless
# containers (no GPU/display, no input device), and consoles on hvc0 (not VGA).
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_NET_9P_VIRTIO is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_DRM is not set
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_IPV6_SIT is not set
# A guest doesn't manage CPU frequency (the host does), so drop the whole
# cpufreq subsystem — this also removes X86_INTEL_PSTATE, which otherwise logs
# "CPU model not supported" and does nothing. SCHED_MC_PRIO (Turbo Boost Max
# 3.0 core priorities — host's concern, not the guest's) force-selects both
# CPU_FREQ and X86_INTEL_PSTATE, so it has to go first.
# CONFIG_SCHED_MC_PRIO is not set
# CONFIG_CPU_FREQ is not set
# io_uring is unused (Go's netpoller uses epoll, crun doesn't need it) and is a
# high-value exploit surface; keep it off.
# CONFIG_IO_URING is not set
