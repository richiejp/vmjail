# KSPP-aligned hardening for the microvm kernel.
#
# The tinyconfig base drops the hardening x86_64_defconfig provided for free, so
# this fragment first restores parity (KASLR, stack protector, retpoline, W^X
# audit) and then layers on the heap/usercopy/codegen hardening defconfig never
# had. Merged LAST so it wins over the base + kvm_guest fragments.

# --- Restore parity with defconfig (lost going to tinyconfig) ---------------
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_DEBUG_WX=y
# allnoconfig compiles out *all* CPU vuln mitigations (CPU_MITIGATIONS=n).
# Turn the master switch on so retpoline et al are built and active.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_RETPOLINE=y

# --- Heap / page-allocator hardening (defconfig never set these) ------------
# tinyconfig selects SLUB_TINY, which is incompatible with freelist hardening;
# switch to the full SLUB allocator so the slab hardening below can apply.
# CONFIG_SLUB_TINY is not set
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y

# --- Usercopy / fortify / structure integrity -------------------------------
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y

# --- Codegen-level defense --------------------------------------------------
CONFIG_ZERO_CALL_USED_REGS=y
# NOTE: GCC_PLUGIN_STACKLEAK is unavailable — gcc-15.2 lacks
# HAVE_GCC_PLUGIN_STACKLEAK (the in-tree stackleak plugin doesn't support this
# gcc). Stack auto-init (INIT_STACK_ALL_ZERO, via -ftrivial-auto-var-init=zero)
# covers much of the same ground. The bigger missing mitigation is forward-edge
# CFI (KCFI/CFI_CLANG) — clang-only, so out of reach until/unless the kernel
# build switches to clang. See PLAN.md spike notes.

# --- Page-table integrity ---------------------------------------------------
CONFIG_PAGE_TABLE_CHECK=y

# --- Memory-error sampling: KFENCE is a ~zero-overhead UAF/OOB detector ------
# (sampling-based, unlike KASAN). Default 100ms sample interval; cheap enough
# to leave on in production for a long-lived sandbox-host kernel.
CONFIG_KFENCE=y
CONFIG_KFENCE_SAMPLE_INTERVAL=100
