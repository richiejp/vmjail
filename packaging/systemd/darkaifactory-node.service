[Unit]
Description=darkaifactory sandbox node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=darkaifactory-node
Group=darkaifactory-node
SupplementaryGroups=kvm
EnvironmentFile=/etc/darkaifactory/node.env
Environment=DAFT_STATE_DIR=/var/lib/darkaifactory-node
Environment=DAFT_STORE_DIR=/var/lib/darkaifactory-node/images
Environment=XDG_CACHE_HOME=/var/cache/darkaifactory-node
ExecStart=/usr/local/lib/darkaifactory/daft-sandboxd serve --orchestrator ${DAFT_ORCHESTRATOR_ADDRESS} --config-dir /var/lib/darkaifactory-node --vsock-dir /run/darkaifactory-node/vsock
StateDirectory=darkaifactory-node
StateDirectoryMode=0700
CacheDirectory=darkaifactory-node
CacheDirectoryMode=0700
RuntimeDirectory=darkaifactory-node
RuntimeDirectoryMode=0700
Delegate=true
DeviceAllow=/dev/kvm rw
Restart=on-failure
RestartSec=2s
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
