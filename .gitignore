# Build output
/result
/result-*
# `make build` writes everything under bin/ — kept out of the repo
# root so there's no confusion about which binary is "the final one"
# (the answer: none, dev builds use stub embedded assets; releases
# come from `nix build`).
/bin/
# Stray binaries from accidental `go build` without -o or from
# pre-Makefile-rework workflows.
/daft
/daft-agent
/daft-sandboxd
/cmd/daft/daft
/cmd/daft-agent/daft-agent
/cmd/daft-hello-container/daft-hello-container
/cmd/daft-sandboxd/daft-sandboxd

# Coverage artefacts (transient — coverage.txt baseline IS committed)
/coverage.out

# Go module vendor directory. We deliberately do NOT vendor — the
# Nix build uses buildGoModule with vendorHash, which fetches deps
# independently. Local `go mod vendor` runs (e.g. after `go get`)
# produce a vendor/ directory; keeping it untracked stops it from
# polluting the repo and from racing the vendorHash-driven build.
/vendor/

# Direnv / Nix
/.direnv/
/.envrc.local

# Editor / OS noise
.DS_Store
*.swp
*.swo
