{
  "version": 1,
  "name": "campaign-unknown-group-subcommands-succeed",
  "steps": [
    {
      "name": "workspace-rejects-unknown-subcommand",
      "argv": ["vmjail", "workspace", "definitely-not-a-command"],
      "timeout_seconds": 5,
      "want_exit": 1,
      "stderr_contains": ["unknown command"]
    },
    {
      "name": "auth-rejects-unknown-subcommand",
      "argv": ["vmjail", "auth", "definitely-not-a-command"],
      "timeout_seconds": 5,
      "want_exit": 1,
      "stderr_contains": ["unknown command"]
    }
  ]
}
